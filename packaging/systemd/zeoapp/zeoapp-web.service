[Unit]
Description=ZEO App web
PartOf=zeoapp.target
BindsTo=zeoapp-memory-guard.service
After=zeoapp-memory-guard.service
Requires=zeoapp-api.service
After=zeoapp-api.service
StartLimitIntervalSec=60
StartLimitBurst=2

[Service]
Type=exec
User=zeoapp
Group=zeoapp
Slice=zeoapp.slice
WorkingDirectory=/opt/zeoapp/current
ExecStart=/opt/zeoapp/runtime/bin/node --max-old-space-size=256 node_modules/next/dist/bin/next start --experimental-next-config-strip-types --hostname 127.0.0.1 --port 4173
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=
Environment=NODE_PATH=
Environment=HOME=/var/lib/zeoapp
ReadWritePaths=/var/lib/zeoapp
UMask=0077
MemoryAccounting=yes
MemoryMax=384M
OOMPolicy=kill
OOMScoreAdjust=1000
LimitCORE=0
LimitNOFILE=4096
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillMode=control-group
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictSUIDSGID=yes
