[Unit]
Description=ZEO App API
PartOf=zeoapp.target
BindsTo=zeoapp-memory-guard.service
After=zeoapp-memory-guard.service
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/zeoapp/runtime.json
StartLimitIntervalSec=60
StartLimitBurst=2

[Service]
Type=exec
User=zeoapp
Group=zeoapp
Slice=zeoapp.slice
WorkingDirectory=/opt/zeoapp/current
ExecStart=/opt/zeoapp/runtime/bin/node --max-old-space-size=256 server/main.ts /etc/zeoapp/runtime.json
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=
Environment=NODE_PATH=
Environment=HOME=/var/lib/zeoapp
StateDirectory=zeoapp
StateDirectoryMode=0700
UMask=0077
MemoryAccounting=yes
MemoryMax=384M
OOMPolicy=kill
OOMScoreAdjust=1000
LimitCORE=0
LimitNOFILE=4096
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillMode=control-group
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictSUIDSGID=yes
